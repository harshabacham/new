# Exclude Python runtime files, dependencies, and project configs from Vercel deployment
# This guarantees Vercel deploys 100% pure static web assets without triggering Python build runners
*.py
*.bat
*.ipynb
*.parquet
requirements.txt
pyproject.toml
Dockerfile
docker-compose.yml
models/
tests/
phase_1/
phase_2/
phase_3/
phase_4/
phase_5/
