{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/data/health.json"
    },
    {
      "source": "/api/v1/forecasts",
      "destination": "/data/forecasts.json"
    },
    {
      "source": "/api/v1/benchmarks",
      "destination": "/data/benchmark_results.json"
    }
  ]
}
